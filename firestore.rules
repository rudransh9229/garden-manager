rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function signedIn() { return request.auth != null; }
    function isOwner()   { return signedIn() && role() == 'owner'; }
    function isManager() { return signedIn() && role() == 'manager'; }

    // Who can sign in, and as what. Everyone can read their own record; only owners can see or change the rest.
    // (An account with no record here can read and write nothing at all.)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    // Money, invoices and private contact details: owners only.
    match /payments/{id}          { allow read, write: if isOwner(); }
    match /expenses/{id}          { allow read, write: if isOwner(); }
    match /cancellations/{id}     { allow read, write: if isOwner(); }
    match /documents/{id}         { allow read, write: if isOwner(); }
    match /files/{id}             { allow read, write: if isOwner(); }
    match /fileParts/{id}         { allow read, write: if isOwner(); }
    match /clientPrivate/{id}     { allow read, write: if isOwner(); }
    match /bookingPrivate/{id}    { allow read, write: if isOwner(); }
    match /staffPrivate/{id}      { allow read, write: if isOwner(); }
    match /attendancePrivate/{id} { allow read, write: if isOwner(); }

    // Bookings, clients and settings: both can read, only owners can change.
    match /bookings/{id} { allow read: if isOwner() || isManager(); allow write: if isOwner(); }
    match /clients/{id}  { allow read: if isOwner() || isManager(); allow write: if isOwner(); }
    match /settings/{id} { allow read: if isOwner() || isManager(); allow write: if isOwner(); }

    // The manager runs the day: adds staff names and marks attendance.
    match /staff/{id}      { allow read, write: if isOwner() || isManager(); }
    match /attendance/{id} { allow read, write: if isOwner() || isManager(); }
  }
}
